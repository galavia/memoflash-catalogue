{"format":"flashcards-maths","version":1,"matieres":[{"nom":"Maths - 4e","paquets":[{"nom":"4e · Fractions et opérations","cartes":[{"recto":"$\\dfrac{a}{b} \\times \\dfrac{c}{d}$","verso":"$\\dfrac{a \\times c}{b \\times d}$"},{"recto":"$\\dfrac{a}{b} \\div \\dfrac{c}{d}$ (avec $c \\neq 0$)","verso":"$\\dfrac{a}{b} \\times \\dfrac{d}{c}$"},{"recto":"Calculer $\\dfrac{3}{4} \\times \\dfrac{2}{9}$","verso":"$\\dfrac{6}{36} = \\dfrac{1}{6}$"},{"recto":"Calculer $\\dfrac{5}{6} \\div \\dfrac{10}{9}$","verso":"$\\dfrac{5}{6} \\times \\dfrac{9}{10} = \\dfrac{45}{60} = \\dfrac{3}{4}$"},{"recto":"Calculer $\\dfrac{1}{2} + \\dfrac{2}{3}$","verso":"$\\dfrac{3}{6} + \\dfrac{4}{6} = \\dfrac{7}{6}$"},{"recto":"Calculer $\\dfrac{5}{4} - \\dfrac{1}{3}$","verso":"$\\dfrac{15}{12} - \\dfrac{4}{12} = \\dfrac{11}{12}$"},{"recto":"Calculer $\\dfrac{2}{3} - \\dfrac{3}{4}$","verso":"$\\dfrac{8}{12} - \\dfrac{9}{12} = -\\dfrac{1}{12}$"},{"recto":"Calculer $1 - \\dfrac{2}{5} \\times \\dfrac{3}{4}$","verso":"$1 - \\dfrac{6}{20} = \\dfrac{14}{20} = \\dfrac{7}{10}$"},{"recto":"Qu'est-ce qu'une fraction irréductible ?","verso":"Une fraction que l'on ne peut plus simplifier (numérateur et dénominateur n'ont pas de diviseur commun autre que $1$)"},{"recto":"Simplifier $\\dfrac{42}{56}$","verso":"$\\dfrac{42 \\div 14}{56 \\div 14} = \\dfrac{3}{4}$"},{"recto":"Quel est l'inverse de $\\dfrac{3}{7}$ ?","verso":"$\\dfrac{7}{3}$"},{"recto":"Calculer $\\dfrac{2}{3}$ de $\\dfrac{9}{4}$","verso":"$\\dfrac{2}{3} \\times \\dfrac{9}{4} = \\dfrac{18}{12} = \\dfrac{3}{2}$"}]}]}]}