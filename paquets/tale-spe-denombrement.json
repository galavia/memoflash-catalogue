{"format":"flashcards-maths","version":1,"matieres":[{"nom":"Mathématiques - Tale (spécialité)","paquets":[{"nom":"Tale · Dénombrement","cartes":[{"recto":"Nombre de $k$-uplets d'un ensemble à $n$ éléments","verso":"$n^k$"},{"recto":"Combien de codes à $4$ chiffres ?","verso":"$10^4 = 10\\,000$"},{"recto":"Définition de $n!$","verso":"$n! = n \\times (n - 1) \\times \\dots \\times 2 \\times 1$ (et $0! = 1$)"},{"recto":"Nombre de permutations de $n$ éléments distincts","verso":"$n!$"},{"recto":"Combien d'anagrammes du mot MATHS (lettres distinctes) ?","verso":"$5! = 120$"},{"recto":"Nombre de façons de choisir $k$ éléments parmi $n$ en tenant compte de l'ordre (sans répétition)","verso":"$n \\times (n - 1) \\times \\dots \\times (n - k + 1)$"},{"recto":"Podium de $3$ coureurs parmi $10$","verso":"$10 \\times 9 \\times 8 = 720$"},{"recto":"Combinaisons : nombre de parties à $k$ éléments d'un ensemble à $n$ éléments","verso":"$\\binom{n}{k} = \\dfrac{n!}{k!\\,(n - k)!}$"},{"recto":"Tirage de $3$ cartes parmi $32$ sans tenir compte de l'ordre","verso":"$\\binom{32}{3} = \\dfrac{32 \\times 31 \\times 30}{6} = 4960$"},{"recto":"Symétrie des coefficients binomiaux","verso":"$\\binom{n}{k} = \\binom{n}{n - k}$"},{"recto":"Relation de Pascal","verso":"$\\binom{n}{k} + \\binom{n}{k + 1} = \\binom{n + 1}{k + 1}$"},{"recto":"Formule du binôme de Newton","verso":"$(a + b)^n = \\displaystyle\\sum_{k=0}^{n} \\binom{n}{k} a^{k} b^{n - k}$"},{"recto":"Nombre de parties d'un ensemble à $n$ éléments","verso":"$2^n$ (somme de $\\binom{n}{k}$ pour $k$ de $0$ à $n$)"},{"recto":"Développer $(x + 1)^4$","verso":"$x^4 + 4x^3 + 6x^2 + 4x + 1$"}]}]}]}