{"format":"flashcards-maths","version":1,"matieres":[{"nom":"Maths - 3e","paquets":[{"nom":"3e · Calcul littéral","cartes":[{"recto":"Distributivité simple : $k(a + b)$","verso":"$ka + kb$"},{"recto":"Double distributivité : $(a + b)(c + d)$","verso":"$ac + ad + bc + bd$"},{"recto":"$(a + b)^2$","verso":"$a^2 + 2ab + b^2$"},{"recto":"$(a - b)^2$","verso":"$a^2 - 2ab + b^2$"},{"recto":"$(a + b)(a - b)$","verso":"$a^2 - b^2$"},{"recto":"Factoriser $a^2 - b^2$","verso":"$(a + b)(a - b)$"},{"recto":"Factoriser $a^2 + 2ab + b^2$","verso":"$(a + b)^2$"},{"recto":"Factoriser $a^2 - 2ab + b^2$","verso":"$(a - b)^2$"},{"recto":"Quelle est la différence entre développer et factoriser ?","verso":"Développer : transformer un produit en somme. Factoriser : transformer une somme en produit"},{"recto":"Factoriser $3x + 6$","verso":"$3(x + 2)$"},{"recto":"Développer $(x + 3)^2$","verso":"$x^2 + 6x + 9$"},{"recto":"Développer $(2x - 1)(x + 4)$","verso":"$2x^2 + 8x - x - 4$\n$= 2x^2 + 7x - 4$"},{"recto":"Factoriser $x^2 - 25$","verso":"$(x + 5)(x - 5)$"},{"recto":"Factoriser $4x^2 - 9$","verso":"$(2x + 3)(2x - 3)$"},{"recto":"Factoriser\n$(x+1)(2x-3)$ $-$ $(x+1)(x+5)$","verso":"Facteur commun $(x+1)$ :\n$(x+1)(2x-3-x-5)$\n$=$ $(x+1)(x-8)$"},{"recto":"Réduire $3x^2 + 5x - x^2 + 2x$","verso":"$2x^2 + 7x$"}]}]}]}