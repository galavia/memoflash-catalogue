{"format":"flashcards-maths","version":1,"matieres":[{"nom":"Maths - 3e","paquets":[{"nom":"3e · Puissances et notation scientifique","cartes":[{"recto":"Définition de $a^n$ \n($n$ entier positif non nul)","verso":"$a^n = a \\times a \\times \\dots \\times a$ avec $n$ facteurs"},{"recto":"$a^0$ (avec $a \\neq 0$)","verso":"$1$"},{"recto":"$a^{-n}$ (avec $a \\neq 0$)","verso":"$\\dfrac{1}{a^n}$"},{"recto":"$a^m \\times a^n$","verso":"$a^{m+n}$"},{"recto":"$\\dfrac{a^m}{a^n}$ (avec $a \\neq 0$)","verso":"$a^{m-n}$"},{"recto":"$(a^m)^n$","verso":"$a^{m \\times n}$"},{"recto":"$(a \\times b)^n$","verso":"$a^n \\times b^n$"},{"recto":"$10^{-3}$ en écriture décimale","verso":"$0{,}001$"},{"recto":"Écriture scientifique d'un nombre","verso":"$a \\times 10^n$ avec $1 \\leq a < 10$ et $n$ entier relatif"},{"recto":"Écriture scientifique de $45000$","verso":"$4{,}5 \\times 10^4$"},{"recto":"Écriture scientifique de $0{,}00032$","verso":"$3{,}2 \\times 10^{-4}$"},{"recto":"Calculer $(2 \\times 10^3) \\times (3 \\times 10^{-5})$","verso":"$6 \\times 10^{-2}$"},{"recto":"Simplifier $\\dfrac{5^7}{5^4}$","verso":"$5^{7-4} = 5^3 = 125$"}]}]}]}