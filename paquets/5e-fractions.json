{"format":"flashcards-maths","version":1,"matieres":[{"nom":"Maths - 5e","paquets":[{"nom":"5e · Fractions","cartes":[{"recto":"Que représente la fraction $\\dfrac{a}{b}$ ?","verso":"Le quotient $a \\div b$, c'est-à-dire $a$ parts d'un tout partagé en $b$ parts égales","versoImage":"fig_64cd23d256.png"},{"recto":"Simplifier une fraction","verso":"On divise le numérateur et le dénominateur par un même nombre non nul"},{"recto":"Simplifier $\\dfrac{18}{24}$","verso":"$\\dfrac{18 \\div 6}{24 \\div 6} = \\dfrac{3}{4}$"},{"recto":"Écrire $\\dfrac{2}{5}$ avec le dénominateur $20$","verso":"$\\dfrac{2 \\times 4}{5 \\times 4} = \\dfrac{8}{20}$"},{"recto":"Comparer deux fractions de même dénominateur","verso":"La plus grande est celle qui a le plus grand numérateur"},{"recto":"Comparer $\\dfrac{3}{4}$ et $\\dfrac{5}{6}$","verso":"$\\dfrac{9}{12} < \\dfrac{10}{12}$ donc $\\dfrac{3}{4} < \\dfrac{5}{6}$"},{"recto":"$\\dfrac{a}{c} + \\dfrac{b}{c}$","verso":"$\\dfrac{a+b}{c}$ (même dénominateur)"},{"recto":"Calculer $\\dfrac{1}{3} + \\dfrac{1}{6}$","verso":"$\\dfrac{2}{6} + \\dfrac{1}{6} = \\dfrac{3}{6} = \\dfrac{1}{2}$"},{"recto":"Calculer $\\dfrac{7}{8} - \\dfrac{1}{4}$","verso":"$\\dfrac{7}{8} - \\dfrac{2}{8} = \\dfrac{5}{8}$"},{"recto":"Calculer $\\dfrac{2}{3}$ de $30$","verso":"$\\dfrac{2}{3} \\times 30 = 20$","rectoImage":"fig_dc13227b40.png"},{"recto":"Écrire $\\dfrac{7}{2}$ sous forme décimale","verso":"$3{,}5$"},{"recto":"Écrire $0{,}75$ sous forme de fraction","verso":"$\\dfrac{75}{100} = \\dfrac{3}{4}$"}]}]}],"images":{"fig_64cd23d256.png":"","fig_dc13227b40.png":""}}