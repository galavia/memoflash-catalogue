{
  "format": "flashcards-maths",
  "version": 1,
  "matieres": [
    {
      "nom": "Mathématiques - 3e",
      "paquets": [
        {
          "nom": "3e · Grandeurs composées et conversions",
          "cartes": [
            {
              "recto": "Formule de la vitesse moyenne",
              "verso": "$v = \\dfrac{d}{t}$"
            },
            {
              "recto": "Distance parcourue à vitesse constante",
              "verso": "$d = v \\times t$"
            },
            {
              "recto": "Convertir $1$ m/s en km/h",
              "verso": "1 m/s = 3,6 km/h : on multiplie par $3{,}6$"
            },
            {
              "recto": "Convertir $90$ km/h en m/s",
              "verso": "$90 \\div 3{,}6 = 25$ m/s"
            },
            {
              "recto": "Une voiture parcourt $150$ km en $2$ h. Vitesse moyenne ?",
              "verso": "$\\dfrac{150}{2} = 75$ km/h"
            },
            {
              "recto": "Formule du débit",
              "verso": "$D = \\dfrac{V}{t}$ (volume écoulé par unité de temps)"
            },
            {
              "recto": "Formule de la masse volumique",
              "verso": "$\\rho = \\dfrac{m}{V}$"
            },
            {
              "recto": "$1$ L en cm³ ? en dm³ ?",
              "verso": "1 L = 1 dm³ = 1000 cm³"
            },
            {
              "recto": "$1$ m³ en litres ?",
              "verso": "$1000$ L"
            },
            {
              "recto": "$1$ m² en cm² ?",
              "verso": "10 000 cm²"
            },
            {
              "recto": "$1$ m³ en cm³ ?",
              "verso": "1 000 000 cm³"
            },
            {
              "recto": "Convertir $2$ h $15$ min en heures décimales",
              "verso": "$2 + \\dfrac{15}{60} = 2{,}25$ h"
            }
          ]
        }
      ]
    }
  ]
}
