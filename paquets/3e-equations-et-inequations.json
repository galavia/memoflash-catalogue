     "nom": "3e · Équations et inéquations",
     "cartes": [
      {
       "recto": "Qu'est-ce qu'une solution d'une équation ?",
       "verso": "Une valeur de l'inconnue pour laquelle l'égalité est vraie"
      },
      {
       "recto": "Résoudre $x + a = b$",
       "verso": "$x = b - a$"
      },
      {
       "recto": "Résoudre $ax = b$ (avec $a \\neq 0$)",
       "verso": "$x = \\dfrac{b}{a}$"
      },
      {
       "recto": "Résoudre $3x + 5 = 20$",
       "verso": "$3x = 15$ donc $x = 5$"
      },
      {
       "recto": "Résoudre $2x - 7 = 5x + 2$",
       "verso": "$-3x = 9$ donc $x = -3$"
      },
      {
       "recto": "Résoudre $\\dfrac{x}{4} = 3$",
       "verso": "$x = 12$"
      },
      {
       "recto": "$4$ est-il solution de $3x - 2 = 10$ ?",
       "verso": "Oui, car $3 \\times 4 - 2 = 10$"
      },
      {
       "recto": "Propriété d'un produit nul",
       "verso": "Un produit est nul si et seulement si l'un de ses facteurs est nul : $A \\times B = 0$ équivaut à $A = 0$ ou $B = 0$"
      },
      {
       "recto": "Résoudre $(x - 2)(x + 5) = 0$",
       "verso": "$x - 2 = 0$ ou $x + 5 = 0$, donc $x = 2$ ou $x = -5$"
      },
      {
       "recto": "Résoudre $x^2 = 49$",
       "verso": "$x = 7$ ou $x = -7$"
      },
      {
       "recto": "Que change-t-on dans une inéquation quand on multiplie ou divise par un nombre négatif ?",
       "verso": "On change le sens de l'inégalité"
      },
      {
       "recto": "Résoudre $2x + 3 < 11$",
       "verso": "$2x < 8$ donc $x < 4$"
      },
      {
       "recto": "Résoudre $-3x \\geq 12$",
       "verso": "On divise par $-3$ et on change le sens : $x \\leq -4$"
      },
      {
       "recto": "Les étapes pour résoudre un problème avec une équation",
       "verso": "1. Choisir l'inconnue. 2. Mettre le problème en équation. 3. Résoudre. 4. Vérifier. 5. Répondre par une phrase"
      }
     ]
